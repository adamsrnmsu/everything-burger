                    "hostname": "rtu-2",
                    "start": [
                      {
                        "args": "cat /var/log/burger-bennu.log 2>&1",
                        "type": "exec",
                        "validator": "log=$(cat); grep -Eq 'Setting up bennu' <<<\"$log\" || { echo \"$1: dpkg -i of the PR build failed: $(tail -3 <<<\"$log\")\" >&2; exit 1; }",
                        "wait": true
                      },
                      {
                        "args": "ss -Hltn '( sport = :502 )' | grep -q .",
