                      {
                        "args": "cat /var/log/burger-bennu.log 2>&1",
                        "type": "exec",
                        "validator": "log=$(cat); grep -Eq 'Setting up bennu' <<<\"$log\" || { echo \"$1: dpkg -i of the PR build failed: $(tail -3 <<<\"$log\")\" >&2; exit 1; }",
                        "wait": true
                      },
                      {
                        "args": "ss -Hltn '( sport = :502 )' | grep -q .",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "pgrep -f '(^|/)bennu-field-deviced?( |$)'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "ep=$(sed -n 's#.*<endpoint>\\(tcp://[^<]*\\)</endpoint>.*#\\1#p' /etc/sceptre/config.xml | tail -1); echo \"# provider endpoint: $ep\"; [ -n \"$ep\" ] || { echo 'no provider endpoint in /etc/sceptre/config.xml' >&2; exit 1; }; timeout 30 bennu-probe --endpoint \"$ep\" --command query",
                        "type": "exec",
                        "validator": "grep -q 'lock' || { echo \"$1: provider query returned no waterway tags\" >&2; exit 1; }",
                        "wait": true
                      },
                      {
                        "args": "dpkg-query -W bennu 2>/dev/null | cut -f2 | grep . || echo none",
                        "type": "exec",
                        "validator": "v=$(cat); [ \"$v\" = 6.0.1.abc1234 ] || { echo \"$1 runs bennu $v, want 6.0.1.abc1234\" >&2; exit 1; }",
                        "wait": true
                      },
                      {
                        "args": "ss -Htn state established '( sport = :502 )' | wc -l",
                        "type": "exec",
                        "validator": "[ \"$(cat)\" -gt 0 ] || { echo \"$1: nothing is polling Modbus :502\" >&2; exit 1; }",
                        "wait": true
                      }
                    ]
