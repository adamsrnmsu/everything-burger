{
  "apiVersion": "phenix.sandia.gov/v2",
  "kind": "Scenario",
  "metadata": {
    "annotations": {
      "topology": "ebwes-ignition"
    },
    "name": "ebwes-ignition"
  },
  "spec": {
    "apps": [
      {
        "assetDir": "/phenix/topologies/waterway-arm64",
        "hosts": [
          {
            "hostname": "waterway-provider",
            "metadata": {
              "publish_endpoint": "udp://*;239.0.0.1:40000",
              "publish_points": "/phenix/topologies/waterway-arm64/injects/publishPoints.txt",
              "simulator": "Simulink",
              "solver": "/phenix/topologies/waterway-arm64/injects/simulinksolver",
              "type": "provider"
            }
          },
          {
            "hostname": "rtu-1",
            "metadata": {
              "infrastructure": "waterway",
              "logic": "lowergate.open = 1*((lowersensor.direction == 1) && (lowersensor.active == 1) && (lock.height >= lowerwater.height - 0.1) && (lock.height <= lowerwater.height + 0.1)) + 0*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height >= lowerwater.height - 0.1) && (lock.height <= lowerwater.height + 0.1)) + 1*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height >= lowerwater.height - 0.1) && (lock.height <= lowerwater.height + 0.1)) + 0*((lowersensor.direction == -1) && (lowersensor.active == 1)); lowervalve.open = 1*((lowersensor.direction == 1) && (lowersensor.active == 1) && (lock.height > lowerwater.height)) + 0*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height >= lowerwater.height)) + 1*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height > lowerwater.height)) + 0*((lowersensor.direction == -1) && (lowersensor.active == 1))",
              "modbus": [
                {
                  "name": "lowerwater",
                  "type": "water"
                },
                {
                  "name": "lock",
                  "type": "water"
                },
                {
                  "name": "lowergate",
                  "type": "gate"
                },
                {
                  "name": "lowervalve",
                  "type": "valve"
                },
                {
                  "name": "lowersensor",
                  "type": "boat-sensor"
                },
                {
                  "name": "locksensor",
                  "type": "boat-sensor"
                }
              ],
              "provider": "waterway-provider",
              "type": "fd-server"
            }
          },
          {
            "hostname": "rtu-2",
            "metadata": {
              "infrastructure": "waterway",
              "logic": "uppergate.open = 1*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1)) + 0*((uppersensor.direction == 1) && (uppersensor.active == 1)) + 1*((uppersensor.direction == -1) && (uppersensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1)) + 0*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1)); uppervalve.open = 1*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height < upperwater.height)) + 0*((uppersensor.direction == 1) && (uppersensor.active == 1)) + 1*((uppersensor.direction == -1) && (uppersensor.active == 1) && (lock.height < upperwater.height)) + 0*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1))",
              "modbus": [
                {
                  "name": "upperwater",
                  "type": "water"
                },
                {
                  "name": "lock",
                  "type": "water"
                },
                {
                  "name": "uppergate",
                  "type": "gate"
                },
                {
                  "name": "uppervalve",
                  "type": "valve"
                },
                {
                  "name": "uppersensor",
                  "type": "boat-sensor"
                },
                {
                  "name": "locksensor",
                  "type": "boat-sensor"
                }
              ],
              "provider": "waterway-provider",
              "type": "fd-server"
            }
          }
        ],
        "name": "sceptre"
      },
      {
        "hosts": [
          {
            "hostname": "rtu-1",
            "metadata": {
              "helics": {
                "broker": {
                  "hostname": "rtu-2|IF0"
                }
              },
              "modbus": [
                {
                  "name": "bus-01",
                  "type": "bus"
                },
                {
                  "name": "brkr-01",
                  "type": "breaker"
                }
              ],
              "type": "fd-server"
            }
          },
          {
            "hostname": "rtu-2",
            "metadata": {
              "connected_rtus": [
                "rtu-1"
              ],
              "type": "fep"
            }
          },
          {
            "hostname": "waterway-provider",
            "metadata": {
              "connected_rtus": [
                "rtu-2"
              ],
              "type": "fd-client"
            }
          }
        ],
        "metadata": {
          "helics": {
            "broker": {
              "hostname": "rtu-1|IF0"
            }
          }
        },
        "name": "ot-sim"
      },
      {
        "metadata": {
          "broker": {
            "root": "rtu-1|IF0"
          }
        },
        "name": "helics"
      },
      {
        "hosts": [
          {
            "hostname": "ignition",
            "metadata": {
              "api": true,
              "connected_rtus": [
                "rtu-2"
              ],
              "perspective": {
                "open_client": false
              },
              "type": "gateway"
            }
          }
        ],
        "name": "ignition"
      },
      {
        "metadata": {
          "components": [
            {
              "metadata": {
                "vms": [
                  {
                    "hostname": "rtu-1",
                    "start": [
                      {
                        "args": "ss -Hltn '( sport = :502 )' | grep -q .",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "pgrep -f '(^|/)(bennu-field-device|bennu-field-deviced)( |$)'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "ep=$(sed -n 's#.*<endpoint>\\(tcp://[^<]*\\)</endpoint>.*#\\1#p' /etc/sceptre/config.xml | tail -1); echo \"# provider endpoint: $ep\"; [ -n \"$ep\" ] || { echo 'no provider endpoint in /etc/sceptre/config.xml' >&2; exit 1; }; timeout 30 bennu-probe --endpoint \"$ep\" --command query | grep -Eq lock",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -A1 '<io name=.helics-federate.>' /etc/ot-sim/config.xml | grep -Eq '<broker-endpoint>10.1.1.102:24000</broker-endpoint>'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -A1 'modbus-outstation. mode=.server.' /etc/ot-sim/config.xml | grep -Eq '<endpoint>10.1.1.101:502</endpoint>'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -q '<tag>bus-01.voltage</tag>' /etc/ot-sim/config.xml && grep -q '<tag>brkr-01.controls</tag>' /etc/ot-sim/config.xml",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -q -e '--name rtu-1' /etc/phenix/startup/90-helics-broker.sh",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -q 'helics_broker .*--name rtu-1 .*--subbrokers 1 .* -f1 ' /etc/phenix/startup/90-helics-broker.sh",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -q 'ping .* 10.1.1.101 ' /etc/phenix/startup/5-wait-broker.sh",
                        "type": "exec",
                        "wait": true
                      }
                    ]
                  },
                  {
                    "hostname": "rtu-2",
                    "start": [
                      {
                        "args": "ss -Hltn '( sport = :502 )' | grep -q .",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "pgrep -f '(^|/)(bennu-field-device|bennu-field-deviced)( |$)'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "ep=$(sed -n 's#.*<endpoint>\\(tcp://[^<]*\\)</endpoint>.*#\\1#p' /etc/sceptre/config.xml | tail -1); echo \"# provider endpoint: $ep\"; [ -n \"$ep\" ] || { echo 'no provider endpoint in /etc/sceptre/config.xml' >&2; exit 1; }; timeout 30 bennu-probe --endpoint \"$ep\" --command query | grep -Eq lock",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -A1 'modbus-outstation. mode=.client.' /etc/ot-sim/config.xml | grep -Eq '<endpoint>10.1.1.101:502</endpoint>'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -A1 'dnp3-outstation. mode=.server.' /etc/ot-sim/config.xml | grep -Eq '<endpoint>10.1.1.102:20000</endpoint>'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -q 'helics_broker .*--name rtu-2 .*--broker 10.1.1.101 --local_interface 10.1.1.102:24000 .* -f1 ' /etc/phenix/startup/90-helics-broker.sh",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -B1 '<tag>bus-01.voltage</tag>' /etc/ot-sim/config.xml | grep -q '<address>0</address>' && grep -B1 '<tag>brkr-01.controls</tag>' /etc/ot-sim/config.xml | grep -q '<address>0</address>'",
                        "type": "exec",
                        "wait": true
                      }
                    ]
                  },
                  {
                    "hostname": "waterway-provider",
                    "start": [
                      {
                        "args": "pgrep -f '(^|/)(bennu-simulink-provider|bennu-simulink-provider-helics)( |$)'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "pgrep -f '(^|/)simulinksolver( |$)'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -q ot-sim-message-bus /etc/ot-sim/config.xml",
                        "type": "exec",
                        "wait": true
                      }
                    ]
                  },
                  {
                    "hostname": "ignition",
                    "start": [
                      {
                        "args": "grep -q '\"hostname\": \"10.1.1.102\"' /opt/ignition/data/config/resources/core/com.inductiveautomation.opcua/device/rtu-2/config.json && grep -q '\"port\": 20000' /opt/ignition/data/config/resources/core/com.inductiveautomation.opcua/device/rtu-2/config.json",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "T=/opt/ignition/data/config/resources/core/ignition/tag-definition/default/tags.json; grep -A4 '\"name\": \"voltage\"' $T | grep -q 'AnalogInput0' && grep -A4 '\"name\": \"controls\"' $T | grep -q 'BinaryOutput0'",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "test -f /opt/ignition/data/projects/api/com.inductiveautomation.webdev/resources/tags/doGet.py && test -f /opt/ignition/data/projects/hmi/project.json",
                        "type": "exec",
                        "wait": true
                      },
                      {
                        "args": "grep -q 'systemctl start ignition' /etc/phenix/startup/98-ignition.sh",
                        "type": "exec",
                        "wait": true
                      }
                    ]
                  }
                ]
              },
              "name": "health",
              "type": "cc"
            },
            {
              "metadata": {
                "vms": [
                  {
                    "hostname": "waterway-provider",
                    "start": [
                      {
                        "args": "grep -A1 'dnp3-outstation. mode=.client.' /etc/ot-sim/config.xml | grep -Eq '<endpoint>10.1.1.102:20000</endpoint>'",
                        "type": "exec",
                        "wait": true
                      }
                    ]
                  }
                ]
              },
              "name": "health-otsim-fep-client",
              "type": "cc"
            }
          ],
          "runs": [
            {
              "name": "health",
              "start": [
                "health"
              ]
            },
            {
              "name": "extras-otsim-fep-client",
              "start": [
                "health-otsim-fep-client"
              ]
            }
          ]
        },
        "name": "scorch"
      }
    ]
  }
}
