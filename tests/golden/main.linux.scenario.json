{
  "apiVersion": "phenix.sandia.gov/v2",
  "kind": "Scenario",
  "metadata": {
    "name": "ebwes-main",
    "created": "",
    "updated": "",
    "annotations": {
      "topology": "ebwes-main"
    }
  },
  "spec": {
    "apps": [
      {
        "name": "sceptre",
        "assetDir": "/phenix/topologies/burger-waterway",
        "hosts": [
          {
            "hostname": "simulink-provider",
            "metadata": {
              "gt": "/phenix/topologies/burger-waterway/injects/simulinkgt",
              "gt_template": "/phenix/topologies/burger-waterway/injects/main.tmpl",
              "labels": [
                "elk"
              ],
              "publish_endpoint": "udp://*;239.0.0.1:40000",
              "publish_points": "/phenix/topologies/burger-waterway/injects/publishPoints.txt",
              "simulator": "Simulink",
              "solver": "/phenix/topologies/burger-waterway/injects/simulinksolver",
              "type": "provider"
            }
          },
          {
            "hostname": "rtu-1",
            "metadata": {
              "modbus": [
                {
                  "name": "lowerwater",
                  "type": "water"
                },
                {
                  "name": "lock",
                  "type": "water"
                },
                {
                  "name": "lowergate",
                  "type": "gate"
                },
                {
                  "name": "lowervalve",
                  "type": "valve"
                },
                {
                  "name": "lowersensor",
                  "type": "boat-sensor"
                },
                {
                  "name": "locksensor",
                  "type": "boat-sensor"
                }
              ],
              "infrastructure": "waterway",
              "labels": [
                "elk"
              ],
              "logic": "lowergate.open = 1*((lowersensor.direction == 1) && (lowersensor.active == 1) && (lock.height >= lowerwater.height - 0.1) && (lock.height <= lowerwater.height + 0.1)) + 0*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height >= lowerwater.height - 0.1) && (lock.height <= lowerwater.height + 0.1)) + 1*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height >= lowerwater.height - 0.1) && (lock.height <= lowerwater.height + 0.1)) + 0*((lowersensor.direction == -1) && (lowersensor.active == 1)); lowervalve.open = 1*((lowersensor.direction == 1) && (lowersensor.active == 1) && (lock.height > lowerwater.height)) + 0*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height >= lowerwater.height)) + 1*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height > lowerwater.height)) + 0*((lowersensor.direction == -1) && (lowersensor.active == 1))",
              "provider": "simulink-provider",
              "type": "fd-server"
            }
          },
          {
            "hostname": "rtu-2",
            "metadata": {
              "modbus": [
                {
                  "name": "upperwater",
                  "type": "water"
                },
                {
                  "name": "lock",
                  "type": "water"
                },
                {
                  "name": "uppergate",
                  "type": "gate"
                },
                {
                  "name": "uppervalve",
                  "type": "valve"
                },
                {
                  "name": "uppersensor",
                  "type": "boat-sensor"
                },
                {
                  "name": "locksensor",
                  "type": "boat-sensor"
                }
              ],
              "infrastructure": "waterway",
              "labels": [
                "elk"
              ],
              "logic": "uppergate.open = 1*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1)) + 0*((uppersensor.direction == 1) && (uppersensor.active == 1)) + 1*((uppersensor.direction == -1) && (uppersensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1)) + 0*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1)); uppervalve.open = 1*((locksensor.direction == 1) && (locksensor.active == 1) && (lock.height < upperwater.height)) + 0*((uppersensor.direction == 1) && (uppersensor.active == 1)) + 1*((uppersensor.direction == -1) && (uppersensor.active == 1) && (lock.height < upperwater.height)) + 0*((locksensor.direction == -1) && (locksensor.active == 1) && (lock.height >= upperwater.height - 0.1) && (lock.height <= upperwater.height + 0.1))",
              "provider": "simulink-provider",
              "type": "fd-server"
            }
          }
        ]
      },
      {
        "name": "mirror",
        "hosts": [
          {
            "hostname": "monitor",
            "metadata": {
              "interface": "mirror",
              "vlans": [
                "SCADA",
                "ICS"
              ]
            }
          }
        ]
      },
      {
        "name": "mgmt_tap",
        "metadata": {
          "subnet": "172.16.0.0/16",
          "vlan": "MGMT"
        }
      },
      {
        "name": "helics",
        "metadata": {
          "broker": {
            "root": "rtu-1|IF0"
          }
        }
      },
      {
        "name": "scorch",
        "metadata": {
          "components": [
            {
              "name": "health",
              "type": "cc",
              "metadata": {
                "vms": [
                  {
                    "hostname": "rtu-1",
                    "start": [
                      {
                        "type": "exec",
                        "args": "dpkg-query -W bennu 2>/dev/null | cut -f2 | grep . || echo none",
                        "wait": true,
                        "validator": "[ \"$(cat)\" != none ] || { echo \"$1: bennu not installed\" >&2; exit 1; }"
                      },
                      {
                        "type": "exec",
                        "args": "grep -q -e '--name rtu-1' /etc/phenix/startup/90-helics-broker.sh",
                        "wait": true
                      },
                      {
                        "type": "exec",
                        "args": "ss -Hltn '( sport = :502 )' | grep -q .",
                        "wait": true
                      },
                      {
                        "type": "exec",
                        "args": "pgrep -f '(^|/)bennu-field-deviced?( |$)'",
                        "wait": true
                      },
                      {
                        "type": "exec",
                        "args": "ep=$(sed -n 's#.*<endpoint>\\(tcp://[^<]*\\)</endpoint>.*#\\1#p' /etc/sceptre/config.xml | tail -1); echo \"# provider endpoint: $ep\"; [ -n \"$ep\" ] || { echo 'no provider endpoint in /etc/sceptre/config.xml' >&2; exit 1; }; timeout 30 bennu-probe --endpoint \"$ep\" --command query | grep -Eq lock",
                        "wait": true
                      }
                    ]
                  },
                  {
                    "hostname": "rtu-2",
                    "start": [
                      {
                        "type": "exec",
                        "args": "dpkg-query -W bennu 2>/dev/null | cut -f2 | grep . || echo none",
                        "wait": true,
                        "validator": "[ \"$(cat)\" != none ] || { echo \"$1: bennu not installed\" >&2; exit 1; }"
                      },
                      {
                        "type": "exec",
                        "args": "ss -Hltn '( sport = :502 )' | grep -q .",
                        "wait": true
                      },
                      {
                        "type": "exec",
                        "args": "pgrep -f '(^|/)bennu-field-deviced?( |$)'",
                        "wait": true
                      },
                      {
                        "type": "exec",
                        "args": "ep=$(sed -n 's#.*<endpoint>\\(tcp://[^<]*\\)</endpoint>.*#\\1#p' /etc/sceptre/config.xml | tail -1); echo \"# provider endpoint: $ep\"; [ -n \"$ep\" ] || { echo 'no provider endpoint in /etc/sceptre/config.xml' >&2; exit 1; }; timeout 30 bennu-probe --endpoint \"$ep\" --command query | grep -Eq lock",
                        "wait": true
                      }
                    ]
                  },
                  {
                    "hostname": "simulink-provider",
                    "start": [
                      {
                        "type": "exec",
                        "args": "dpkg-query -W bennu 2>/dev/null | cut -f2 | grep . || echo none",
                        "wait": true,
                        "validator": "[ \"$(cat)\" != none ] || { echo \"$1: bennu not installed\" >&2; exit 1; }"
                      },
                      {
                        "type": "exec",
                        "args": "pgrep -f '(^|/)bennu-simulink-provider(-helics)?( |$)'",
                        "wait": true
                      },
                      {
                        "type": "exec",
                        "args": "pgrep -f '(^|/)simulinksolver( |$)'",
                        "wait": true
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "disruption",
              "type": "disruption",
              "metadata": {
                "current_disruption": "baseline",
                "run_duration": 30
              }
            },
            {
              "name": "pcap",
              "type": "pcap",
              "metadata": {
                "vms": [
                  {
                    "hostname": "rtu-1",
                    "interface": 0,
                    "filter": "not tcp port 502 and not port 5201"
                  },
                  {
                    "hostname": "rtu-2",
                    "interface": 0,
                    "filter": "not port 5201"
                  }
                ],
                "convert_to_json": true
              }
            },
            {
              "name": "tcpdump",
              "type": "tcpdump",
              "metadata": {
                "vms": [
                  {
                    "hostname": "monitor",
                    "iface": "any",
                    "filter": "ip proto 47 and less 600 or tcp port 502"
                  }
                ]
              }
            },
            {
              "name": "mm",
              "type": "mm",
              "metadata": {
                "start": [
                  {
                    "type": "start_capture",
                    "capture": {
                      "bridge": "phenix",
                      "filename": "burger-bridge.pcap",
                      "filter": "tcp port 502"
                    }
                  }
                ],
                "stop": [
                  {
                    "type": "stop_capture",
                    "capture": {
                      "bridge": "phenix",
                      "convert": true
                    }
                  }
                ],
                "vms": [
                  {
                    "hostname": "simulink-provider",
                    "start": [
                      {
                        "type": "start_capture",
                        "capture": {
                          "interface": 0,
                          "filename": "burger-provider.pcap",
                          "filter": "not tcp port 502"
                        }
                      }
                    ],
                    "stop": [
                      {
                        "type": "stop_capture",
                        "capture": {
                          "interface": 0,
                          "convert": true
                        }
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "pipe",
              "type": "pipe",
              "metadata": {
                "pipe": "burger",
                "data": "hello-from-burger"
              }
            },
            {
              "name": "hoststats",
              "type": "hoststats",
              "metadata": {
                "pollPeriod": 5
              },
              "background": true
            },
            {
              "name": "vmstats",
              "type": "vmstats",
              "metadata": {
                "vms": [
                  "rtu-1",
                  "rtu-2",
                  "simulink-provider"
                ],
                "pollPeriod": 1
              }
            },
            {
              "name": "qos",
              "type": "qos",
              "metadata": {
                "vms": [
                  {
                    "hostname": "rtu-2",
                    "interface": 0,
                    "delay": 20
                  }
                ]
              }
            },
            {
              "name": "erspan",
              "type": "erspan",
              "metadata": {
                "local_bridge": "phenix",
                "local_ip": "192.0.2.1",
                "remote_ip": "192.0.2.2"
              }
            },
            {
              "name": "iperf",
              "type": "iperf",
              "metadata": {
                "run_duration": 20,
                "add_client_args": "--omit 2",
                "bandwidth": 10000000,
                "iperf_version": "3.15",
                "iperf_paths": {
                  "linux": "/usr/local/bin/iperf3-3.15"
                },
                "servers": [
                  {
                    "hostname": "rtu-1",
                    "port_range_start": 5201,
                    "clients": [
                      {
                        "hostname": "rtu-2"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "snort-conf",
              "type": "cc",
              "metadata": {
                "vms": [
                  {
                    "hostname": "rtu-1",
                    "configure": [
                      {
                        "type": "exec",
                        "wait": true,
                        "args": "systemctl disable --now snort >/dev/null 2>&1 || true\ncat > /etc/snort/snort.conf <<'CONF'\nconfig checksum_mode: none\npreprocessor perfmonitor: time 5 file /var/log/snort/snort.stats pktcnt 1\noutput alert_full: alert\noutput log_unified2: filename snort.log, limit 128, nostamp\nalert tcp any any -> any 502 (msg:\"burger modbus\"; sid:1000001; rev:1;)\nCONF\n"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "snort",
              "type": "snort",
              "metadata": {
                "hostname": "rtu-1",
                "sniffInterface": "IF0",
                "waitDuration": 20
              }
            },
            {
              "name": "cc-empty-output",
              "type": "cc",
              "metadata": {
                "vms": [
                  {
                    "hostname": "rtu-1",
                    "start": [
                      {
                        "type": "exec",
                        "args": "true",
                        "wait": true,
                        "validator": "[ -z \"$(cat)\" ] || { echo \"$1: expected no output\" >&2; exit 1; }"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "cc-output-parsing",
              "type": "cc",
              "metadata": {
                "vms": [
                  {
                    "hostname": "rtu-1",
                    "start": [
                      {
                        "type": "exec",
                        "args": "echo 'warn: x' >&2; echo 'tcp 0 0 0.0.0.0:22 0.0.0.0:* LISTEN 812/sshd'",
                        "wait": true,
                        "validator": "out=$(cat); grep -Fxq 'tcp 0 0 0.0.0.0:22 0.0.0.0:* LISTEN 812/sshd' <<<\"$out\" || { echo \"$1: cc stdout came back as: $out\" >&2; exit 1; }"
                      }
                    ]
                  }
                ]
              }
            },
            {
              "name": "ettercap",
              "type": "ettercap",
              "metadata": {
                "vms": [
                  {
                    "hostname": "kali",
                    "iface": "IF0",
                    "targets": "/10.1.1.101// /10.1.1.1//"
                  }
                ]
              }
            },
            {
              "name": "mitm-capture",
              "type": "tcpdump",
              "metadata": {
                "vms": [
                  {
                    "hostname": "kali",
                    "iface": "IF0",
                    "filter": "tcp port 502"
                  }
                ]
              }
            },
            {
              "name": "trafficgen",
              "type": "trafficgen",
              "metadata": {
                "scripts": {
                  "trafficServer": "/phenix/burger/x/assets/traffic-server.py",
                  "backgroundGen": "/phenix/burger/x/assets/background-gen.py",
                  "malwareGen": "/phenix/burger/x/assets/malware-gen.py"
                },
                "targets": [
                  {
                    "hostname": "traffic-server",
                    "interface": "IF0",
                    "duration": 20,
                    "backgroundClient": {
                      "hostname": "background-gen",
                      "rate": 50,
                      "probability": 0.5
                    },
                    "malwareClient": {
                      "hostname": "malware-gen",
                      "rate": 10,
                      "probability": 1.0
                    }
                  }
                ]
              }
            }
          ],
          "runs": [
            {
              "name": "health",
              "start": [
                "health"
              ]
            },
            {
              "name": "main",
              "configure": [
                "disruption",
                "iperf",
                "snort-conf",
                "snort"
              ],
              "start": [
                "pcap",
                "tcpdump",
                "mm",
                "pipe",
                "hoststats",
                "vmstats",
                "qos",
                "iperf",
                "snort",
                "cc-empty-output",
                "cc-output-parsing",
                "disruption"
              ],
              "stop": [
                "pcap",
                "tcpdump",
                "mm",
                "hoststats",
                "vmstats",
                "qos",
                "iperf",
                "snort"
              ],
              "cleanup": [
                "disruption",
                "pipe",
                "iperf",
                "snort"
              ]
            },
            {
              "name": "mitm",
              "start": [
                "mitm-capture",
                "ettercap"
              ],
              "stop": [
                "ettercap",
                "mitm-capture"
              ]
            },
            {
              "name": "trafficgen",
              "configure": [
                "trafficgen"
              ],
              "start": [
                "trafficgen"
              ],
              "stop": [
                "trafficgen"
              ],
              "cleanup": [
                "trafficgen"
              ]
            },
            {
              "name": "extras-erspan",
              "configure": [
                "erspan"
              ],
              "cleanup": [
                "erspan"
              ]
            }
          ]
        }
      }
    ]
  }
}
