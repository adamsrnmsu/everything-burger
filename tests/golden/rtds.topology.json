{
  "apiVersion": "phenix.sandia.gov/v1",
  "kind": "Topology",
  "metadata": {
    "name": "ebwes-rtds"
  },
  "spec": {
    "nodes": [
      {
        "general": {
          "hostname": "pp1"
        },
        "hardware": {
          "drives": [
            {
              "image": "p.qc2"
            }
          ],
          "os_type": "linux"
        },
        "injections": [
          {
            "description": "burger: install bennu PR build",
            "dst": "/etc/phenix/startup/00-burger-bennu.sh",
            "permissions": "0755",
            "src": "/phenix/burger/x/00-burger-bennu.sh"
          },
          {
            "description": "burger: bennu PR build",
            "dst": "/root/burger-bennu.deb",
            "src": "/phenix/burger/x/bennu.deb"
          },
          {
            "description": "burger: pybennu PR build",
            "dst": "/root/pybennu-6.0.0-py3-none-any.whl",
            "src": "/phenix/burger/x/pybennu-6.0.0-py3-none-any.whl"
          },
          {
            "description": "burger: pybennu dependency",
            "dst": "/root/loguru-0.7.3-py3-none-any.whl",
            "src": "/phenix/burger/x/wheels/loguru-0.7.3-py3-none-any.whl"
          },
          {
            "description": "burger: miniccc from the minimega container",
            "dst": "/root/burger-miniccc",
            "src": "/phenix/burger/x/burger-miniccc"
          },
          {
            "description": "burger: install and start miniccc",
            "dst": "/etc/phenix/startup/01-burger-miniccc.sh",
            "permissions": "0755",
            "src": "/phenix/burger/x/01-burger-miniccc.sh"
          }
        ],
        "network": {
          "interfaces": []
        }
      }
    ]
  }
}
