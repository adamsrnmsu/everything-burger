NAME=ignition83-commissioned-arm64
MIRROR=http://ports.ubuntu.com/ubuntu-ports
RELEASE=noble
VARIANT=minbase
PACKAGES="ca-certificates curl fontconfig iproute2 iputils-ping openssh-server systemd-sysv libfreetype6 locales tzdata libxext6 libxrender1 libxtst6 libxi6"
SCRIPTS="$IGNITION83_DIR/ignition83.sh"  # absolute: build.sh (waterway repo) takes absolute paths as-is
OVERLAYS="/phenix/images/overlays-src/ignition83-arm64"
SIZE=12G
MINGUI=0
